{
  "name": "chiffra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --test tests/contracts.test.mjs",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "build:server": "tsc -p tsconfig.server.json",
    "test:server": "node --test --test-concurrency=1 tests/batches.test.mjs tests/bank-csv.test.mjs tests/bank-statements.test.mjs tests/batch-ingestion.test.mjs tests/observations.test.mjs tests/uploads.test.mjs tests/xlsx.test.mjs tests/xlsx-upload.test.mjs",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "build:web": "vite build --config apps/web/vite.config.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "bullmq": "^5.0.0",
    "decimal.js": "^10.6.0",
    "fastify": "^5.12.5",
    "pg": "^8.0.0",
    "read-excel-file": "^9.3.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "^8.3.0"
  }
}
